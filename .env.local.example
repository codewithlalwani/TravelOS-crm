DB_HOST=localhost
DB_PORT=3306
DB_NAME=travel_crm
DB_USER=root
DB_PASSWORD=100

JWT_SECRET=generate-with-openssl-rand-hex-32
SESSION_COOKIE_NAME=fc_session

UPLOAD_DIR=./uploads
# Must match the protocol actually used to reach the app in production (http vs https).
# The session cookie's `secure` flag is derived from this — set it to https://... only
# once the site is served over real HTTPS, otherwise the browser will silently drop the
# login cookie and every navigation will look like an instant logout.
APP_BASE_URL=http://localhost:3000

# Production admin user — auto-created by db/migrations/20260101000039-seed-admin-user.js
# on first `npm run db:migrate` / `npm start`. Required when NODE_ENV=production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=System Admin

# Leave SMTP_HOST empty to use a local dev transport (emails are logged, not actually delivered)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Agent authentication/account-security mail only. travelfs9.com currently uses
# Google Workspace; confirm the mailbox provider before setting host/port/encryption.
# For Google Workspace app-password SMTP: smtp.gmail.com / 465 / ssl.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=
AUTH_SMTP_ENCRYPTION=
AUTH_SMTP_USERNAME=noreply@travelfs9.com
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=noreply@travelfs9.com
AUTH_SMTP_FROM_NAME="Travel OS Security"

# PayGlocal: set PAYGLOCAL_MODE=live once the two PEM files below exist under keys/payglocal/
PAYGLOCAL_MODE=uat
PAYGLOCAL_ENV=uat
PAYGLOCAL_WEBHOOK_SECRET=changeme

PG_MERCHANT_ID=
PG_PARENT_MERCHANT_ID=
PG_PUBLIC_KEY_KID=
PG_PUBLIC_KEY_PATH=./keys/payglocal/public-key.pem
PG_PRIVATE_KEY_KID=
PG_PRIVATE_KEY_PATH=./keys/payglocal/private-key.pem

# SerpApi (Google Flights) — used for flight/airport search in the New Booking wizard
SERPAPI_API_KEY=

# Google Places API — backs every City suggestion field (Dep/Arr City, billing address city)
GOOGLE_MAPS_API_KEY=
